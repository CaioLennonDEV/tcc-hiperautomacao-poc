{
  "name": "PoC - Triagem Inteligente GLPI (Hiperautomacao)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "glpi-ticket-webhook",
        "options": {}
      },
      "id": "0f4f174a-4cc9-47ca-9cc3-27fc11d7aa0e",
      "name": "Webhook GLPI (Novo Chamado)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -512,
        -64
      ],
      "webhookId": "1392cd95-5c63-4799-bc31-9c9cf1a419c4"
    },
    {
      "parameters": {
        "text": "=Chamado Recebido do GLPI:\nTítulo: {{$json.body.ticket_title}}\nDescrição: {{$json.body.ticket_description}}\nSolicitante: {{$json.body.user_email}}",
        "options": {
          "systemMessage": "Você é um classificador determinístico para triagem de chamados do GLPI integrado à esteira de hiperautomação. Responda ESTRITAMENTE em formato JSON com as chaves: intencao, urgencia, categoria_glpi, confianca (0.0 a 1.0), resumo_demanda, resposta_sugerida e requer_revisao_humana (booleano, true se confianca < 0.85 ou alta ambiguidade/risco crítico)."
        }
      },
      "id": "069a5c14-0521-4f4a-b72c-a4c9b2271a33",
      "name": "Agente Cognitivo LLM (Parsing)",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1,
      "position": [
        -288,
        -64
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.output.output.requer_revisao_humana }}",
              "value2": false
            }
          ],
          "number": [
            {
              "value1": "={{ $json.output.output.confianca }}",
              "operation": "largerEqual",
              "value2": 0.85
            }
          ]
        }
      },
      "id": "95a91234-6703-4dac-92dd-f73c984128d0",
      "name": "Verifica Confianca (Score >= 0.85)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        64,
        -64
      ]
    },
    {
      "parameters": {
        "tableId": "chamados_triagem",
        "fieldsUi": {
          "fieldValues": [
            {
              "fieldId": "glpi_ticket_id",
              "fieldValue": "={{ Number($('Webhook GLPI (Novo Chamado)').item.json.body.ticket_id) }}"
            },
            {
              "fieldId": "remetente_email",
              "fieldValue": "={{ $('Webhook GLPI (Novo Chamado)').item.json.body.user_email || 'nao-informado@sistema.local' }}"
            },
            {
              "fieldId": "conteudo_original",
              "fieldValue": "={{ $('Webhook GLPI (Novo Chamado)').item.json.body.ticket_title + ' - ' + $('Webhook GLPI (Novo Chamado)').item.json.body.ticket_description }}"
            },
            {
              "fieldId": "intencao_classificada",
              "fieldValue": "={{ $('Agente Cognitivo LLM (Parsing)').item.json.output.output.intencao }}"
            },
            {
              "fieldId": "nivel_urgencia",
              "fieldValue": "={{ $('Agente Cognitivo LLM (Parsing)').item.json.output.output.urgencia }}"
            },
            {
              "fieldId": "categoria_sugerida",
              "fieldValue": "={{ $('Agente Cognitivo LLM (Parsing)').item.json.output.output.categoria_glpi }}"
            },
            {
              "fieldId": "confianca_ia",
              "fieldValue": "={{ $('Agente Cognitivo LLM (Parsing)').item.json.output.output.confianca }}"
            },
            {
              "fieldId": "status_processamento",
              "fieldValue": "={{ ($('Agente Cognitivo LLM (Parsing)').item.json.output.output.requer_revisao_humana || $('Agente Cognitivo LLM (Parsing)').item.json.output.output.confianca < 0.85) ? 'Revisao Humana' : 'Automatico' }}"
            },
            {
              "fieldId": "resposta_sugerida",
              "fieldValue": "={{ $('Agente Cognitivo LLM (Parsing)').item.json.output.output.resposta_sugerida }}"
            },
            {
              "fieldId": "requer_revisao_humana",
              "fieldValue": "={{ Boolean($('Agente Cognitivo LLM (Parsing)').item.json.output.output.requer_revisao_humana || $('Agente Cognitivo LLM (Parsing)').item.json.output.output.confianca < 0.85) }}"
            },
            {
              "fieldId": "tempo_processamento_ms",
              "fieldValue": "={{ $json.tempo_processamento_ms || 1900 }}"
            }
          ]
        }
      },
      "id": "bef19d05-af16-4b66-81b7-d77b06c0e76c",
      "name": "Registra Auditoria no Supabase",
